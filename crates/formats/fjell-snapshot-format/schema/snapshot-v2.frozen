# crate: fjell-snapshot-format
# format: SnapshotEnvelopeV2
# version: v0.7.0 (frozen) BREAKING-SCHEMA: see ADR-v0.7-004
magic "FJELL-SNAPSHOT-V1"
field schema_version          u16 LE
